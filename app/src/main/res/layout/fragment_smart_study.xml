<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Active Challenge Screen -->
        <LinearLayout
            android:id="@+id/layout_smart_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Badge & Mastery XP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_smart_level_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🧠 SMART ADAPTIVE TEST"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_smart_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 0"
                    android:textColor="@color/accent_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mode Selector Chips (Multiple Choice vs Free Recall Challenge) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_multichoice"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Rapid Recall"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_socratic"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Socratic Probe"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Progress Bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/smart_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:progress="33"
                app:indicatorColor="@color/md_theme_primary"
                app:trackColor="@color/md_theme_surfaceVariant" />

            <TextView
                android:id="@+id/tv_smart_q_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Question 1 of 3 (Adaptive Difficulty)"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="12sp" />

            <!-- Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outline"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_smart_difficulty_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIFFICULTY: CONCEPTUAL APPLICATION"
                        android:textColor="@color/accent_amber"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_smart_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Smart question testing core active principles..."
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 1: Multiple Choice Options -->
            <RadioGroup
                android:id="@+id/rg_smart_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rb_smart_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/badge_bg"
                    android:padding="12dp"
                    android:text="Option 1"
                    android:textColor="@color/md_theme_onSurface" />

                <RadioButton
                    android:id="@+id/rb_smart_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/badge_bg"
                    android:padding="12dp"
                    android:text="Option 2"
                    android:textColor="@color/md_theme_onSurface" />

                <RadioButton
                    android:id="@+id/rb_smart_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/badge_bg"
                    android:padding="12dp"
                    android:text="Option 3"
                    android:textColor="@color/md_theme_onSurface" />

                <RadioButton
                    android:id="@+id/rb_smart_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/badge_bg"
                    android:padding="12dp"
                    android:text="Option 4"
                    android:textColor="@color/md_theme_onSurface" />
            </RadioGroup>

            <!-- Mode 2: Socratic Free Recall Input -->
            <LinearLayout
                android:id="@+id/layout_socratic_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type your active explanation from memory...">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_socratic_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="3"
                        android:gravity="top" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tip: Explain like you are teaching a beginner to cement long-term memory."
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Smart Feedback / Analysis Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_smart_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/md_theme_primaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_smart_feedback_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Smart Analysis"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_smart_feedback_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Feedback explanation text..."
                        android:textColor="@color/md_theme_onSurface"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit / Continue Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_smart_action"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Submit Knowledge Check"
                android:textColor="#FFFFFF"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- Smart Test Completed View -->
        <LinearLayout
            android:id="@+id/layout_smart_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:text="🧠"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Knowledge Mastery Verified!"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_smart_final_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="You scored 3/3 (100% Retention Score)\nYour retention curve has increased by +15%!"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_smart_restart"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Challenge Again"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
